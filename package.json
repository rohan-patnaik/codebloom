{
  "name": "codebloom",
  "displayName": "Codebloom — Code Mind Maps",
  "description": "See any file as a pastel mind map of its classes and functions, with real code on every branch and call arrows between them. Python, Java and JavaScript built in; TypeScript, Go, Rust, C# and more through your language extensions.",
  "version": "0.4.0",
  "publisher": "rohan-patnaik",
  "author": {
    "name": "Rohan Patnaik",
    "email": "rohanpatnaik1997@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohan-patnaik/codebloom.git"
  },
  "homepage": "https://github.com/rohan-patnaik/codebloom#readme",
  "bugs": {
    "url": "https://github.com/rohan-patnaik/codebloom/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#262136",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mind map",
    "call graph",
    "code map",
    "outline",
    "python",
    "java",
    "javascript",
    "typescript",
    "go",
    "rust",
    "visualization",
    "navigation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codebloom.map"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codebloom.openMap",
        "title": "Open Mind Map",
        "category": "Codebloom",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "codebloom.openMapInTab",
        "title": "Open Mind Map in New Tab",
        "category": "Codebloom",
        "icon": "$(link-external)"
      },
      {
        "command": "codebloom.openMapForFile",
        "title": "Open in Codebloom Mind Map",
        "category": "Codebloom"
      },
      {
        "command": "codebloom.copyBlockContext",
        "title": "Copy Block at Cursor as LLM Context",
        "category": "Codebloom"
      },
      {
        "command": "codebloom.reindex",
        "title": "Re-index Workspace",
        "category": "Codebloom"
      },
      {
        "command": "codebloom.chooseLanguages",
        "title": "Choose Languages…",
        "category": "Codebloom"
      },
      {
        "command": "codebloom.toggleMaximize",
        "title": "Toggle Full-Width Map",
        "category": "Codebloom"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codebloom.openMap",
          "when": "resourceLangId in codebloom.languages",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "codebloom.openMapForFile",
          "when": "resourceLangId in codebloom.languages",
          "group": "navigation@90"
        },
        {
          "command": "codebloom.openMapInTab",
          "when": "resourceLangId in codebloom.languages",
          "group": "navigation@91"
        }
      ],
      "editor/context": [
        {
          "command": "codebloom.copyBlockContext",
          "when": "resourceLangId in codebloom.languages",
          "group": "9_cutcopypaste@90"
        }
      ],
      "commandPalette": [
        {
          "command": "codebloom.openMapForFile",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codebloom.openMap",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && resourceLangId in codebloom.languages"
      }
    ],
    "configuration": {
      "title": "Codebloom",
      "properties": {
        "codebloom.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python",
            "java",
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "css",
            "scss",
            "less",
            "html",
            "markdown"
          ],
          "markdownDescription": "Language ids Codebloom maps. Python, Java and JavaScript use the built-in parsers. Every other language is mapped from the outline its language extension provides, so it adds nothing to Codebloom's size. Run **Codebloom: Choose Languages…** to pick from a list."
        },
        "codebloom.preferLanguageServer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Map Python, Java and JavaScript from their language extensions (Pylance, the Java language server, TypeScript) instead of the built-in parsers. Call links can be more accurate, but maps open more slowly and cross-file links come one block at a time."
        },
        "codebloom.openLocation": {
          "type": "string",
          "enum": [
            "beside",
            "tab"
          ],
          "default": "beside",
          "enumDescriptions": [
            "Open the map in a split beside your code.",
            "Open the map as a full-width tab in the current editor group. Clicking a block no longer jumps the editor; use Go to code or Enter."
          ],
          "description": "Where the mind map opens."
        },
        "codebloom.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Switch the map to whichever supported file you open in the editor."
        },
        "codebloom.syncCursor": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the block under the editor cursor in the map."
        },
        "codebloom.revealOnClick": {
          "type": "boolean",
          "default": true,
          "description": "Clicking a block scrolls the editor to it."
        },
        "codebloom.defaultMode": {
          "type": "string",
          "enum": [
            "names",
            "code"
          ],
          "default": "names",
          "description": "Show block names only (open the selected one as code), or every block as a code card."
        },
        "codebloom.maxCardLines": {
          "type": "number",
          "default": 24,
          "minimum": 4,
          "maximum": 400,
          "description": "Lines a code card shows at once. Longer blocks scroll inside the selected card; scroll past the end to move on to the next block."
        },
        "codebloom.indexWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Index the workspace in the background so calls and callers link across files."
        },
        "codebloom.maxFiles": {
          "type": "number",
          "default": 4000,
          "description": "Upper limit on files indexed for cross-file links."
        },
        "codebloom.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/venv/**",
            "**/.venv/**",
            "**/__pycache__/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/target/**",
            "**/*.min.js"
          ],
          "description": "Glob patterns skipped by the workspace index."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs && node --test test/*.test.cjs",
    "test:vscode": "node scripts/build.mjs && node test/integration/run.cjs",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.25.10"
  }
}
